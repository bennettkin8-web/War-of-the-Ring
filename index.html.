<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>War of the Ring: Warlords of Middle-earth</title>
    <style>
        @import url('https://googleapis.com');
        
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            image-rendering: pixelated;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #1a1a1a;
            font-family: 'Courier Prime', monospace;
            color: #d4ccb6;
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .pixel-panel {
            background-color: #2c251e;
            border: 4px solid #140f0b;
            outline: 2px solid #84694d;
            outline-offset: -6px;
            padding: 12px;
            box-shadow: 0 4px 0 rgba(0,0,0,0.4);
        }

        .pixel-btn {
            background-color: #5a4a3a;
            color: #fffbdf;
            border: 3px solid #140f0b;
            outline: 1px solid #a89070;
            outline-offset: -4px;
            padding: 8px 16px;
            cursor: pointer;
            font-family: 'Courier Prime', monospace;
            font-weight: bold;
            font-size: 14px;
            text-transform: uppercase;
            text-align: center;
        }

        .pixel-btn:hover {
            background-color: #735f4b;
            color: #ffffff;
        }

        .pixel-btn:active {
            transform: translateY(2px);
            background-color: #403428;
        }

        #title-screen {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle, #3a3126 0%, #120e0a 100%);
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 10px solid #140f0b;
        }

        #title-logo {
            font-size: 32px;
            text-align: center;
            color: #d4af37;
            text-shadow: 3px 3px 0px #000;
            margin-bottom: 40px;
            max-width: 800px;
            padding: 20px;
        }

        .title-buttons {
            display: flex;
            flex-direction: column;
            gap: 15px;
            width: 250px;
        }

        #top-hud {
            width: 100%;
            height: 60px;
            background-color: #241e17;
            border-bottom: 4px solid #140f0b;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            z-index: 10;
        }

        .hud-stat {
            font-size: 16px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        #main-viewport {
            flex: 1;
            position: relative;
            background-color: #3d352a;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        #battle-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 12, 10, 0.95);
            z-index: 50;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .battle-grid {
            display: flex;
            width: 90%;
            max-width: 1000px;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 30px;
        }

        .battle-side {
            width: 48%;
            min-height: 250px;
        }

        .side-title {
            font-size: 20px;
            border-bottom: 2px solid #84694d;
            padding-bottom: 5px;
            margin-bottom: 10px;
        }

        .unit-list-display {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .unit-row-card {
            background: #3d3328;
            padding: 6px;
            border: 2px solid #140f0b;
            font-size: 12px;
            display: flex;
            justify-content: space-between;
        }

        .odds-bar-container {
            width: 90%;
            max-width: 1000px;
            height: 30px;
            background: #8b251e;
            border: 3px solid #140f0b;
            margin-bottom: 40px;
            position: relative;
        }

        #odds-fill {
            height: 100%;
            width: 50%;
            background: #b8860b;
            transition: width 0.3s ease;
        }

        .odds-label {
            position: absolute;
            width: 100%;
            text-align: center;
            top: 4px;
            font-weight: bold;
            color: #fff;
            text-shadow: 1px 1px 1px #000;
            font-size: 14px;
        }

        .battle-choices {
            display: flex;
            gap: 20px;
            width: 90%;
            max-width: 1000px;
        }

        .battle-choices .pixel-btn {
            flex: 1;
            padding: 20px;
            font-size: 16px;
        }

        .shake {
            animation: shakeAnim 0.15s infinite;
        }

        @keyframes shakeAnim {
            0% { transform: translate(1px, 1px) rotate(0deg); }
            10% { transform: translate(-1px, -2px) rotate(-1deg); }
            20% { transform: translate(-3px, 0px) rotate(1deg); }
            30% { transform: translate(0px, 2px) rotate(0deg); }
            40% { transform: translate(1px, -1px) rotate(1deg); }
            50% { transform: translate(-1px, 2px) rotate(-1deg); }
            60% { transform: translate(-3px, 1px) rotate(0deg); }
            70% { transform: translate(2px, 1px) rotate(-1deg); }
            80% { transform: translate(-1px, -1px) rotate(1deg); }
            90% { transform: translate(2px, 2px) rotate(0deg); }
            100% { transform: translate(1px, -2px) rotate(-1deg); }
        }

        #combat-scene-container {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: #222;
            z-index: 60;
            display: none;
            flex-direction: column;
        }

        #combat-hud {
            background: #140f0b;
            padding: 10px;
            display: flex;
            justify-content: space-between;
            color: #fff;
        }

        #log-panel {
            position: absolute;
            bottom: 10px;
            left: 10px;
            width: 320px;
            max-height: 120px;
            background: rgba(20,15,11,0.85);
            border: 2px solid #84694d;
            font-size: 11px;
            padding: 6px;
            overflow-y: auto;
            pointer-events: none;
        }
    </style>
</head>
<body>

<div id="game-container">
    <div id="title-screen">
        <div id="title-logo" class="pixel-panel">
            WAR OF THE RING:<br>
            <span style="font-size: 20px; color: #a89070;">WARLORDS OF MIDDLE-EARTH</span>
        </div>
        <div class="title-buttons">
            <button class="pixel-btn" onclick="Game.startNewCampaign()">New Campaign</button>
            <button class="pixel-btn" id="btn-continue" onclick="Game.loadCampaign()">Continue</button>
        </div>
    </div>

    <div id="top-hud">
        <div class="hud-stat">
            <span id="hud-faction" style="color: #d4af37;">Gondor</span>
        </div>
        <div class="hud-stat">
            <span>GOLD: <span id="hud-gold" style="color: #66ff66;">500</span></span>
            <span style="font-size:12px; color:#aaa;">(+<span id="hud-income">50</span>)</span>
        </div>
        <div class="hud-stat">
            <span>TURN: <span id="hud-turn">1</span></span>
        </div>
        <div>
            <button class="pixel-btn" style="background-color: #8b251e;" onclick="Game.endTurn()">End Turn</button>
        </div>
    </div>

    <div id="main-viewport">
        <canvas id="campaignCanvas"></canvas>
        <div id="log-panel" class="pixel-panel">
            <div style="color: #ffd700;">System Initialized.</div>
        </div>
    </div>

    <div id="battle-overlay">
        <div id="battle-title" class="pixel-panel" style="font-size: 24px; color: #fffbdf; margin-bottom: 20px; width: 90%; max-width: 1000px; text-align: center;">
            BATTLE ENGAGEMENT DETECTED
        </div>
        
        <div class="battle-grid">
            <div id="attacker-card" class="pixel-panel battle-side">
                <div class="side-title" id="battle-attacker-name" style="color: #b8860b;">Gondor Forces</div>
                <div class="unit-list-display" id="battle-attacker-units"></div>
            </div>
            <div id="defender-card" class="pixel-panel battle-side">
                <div class="side-title" id="battle-defender-name" style="color: #8b251e;">Mordor Garrison</div>
                <div class="unit-list-display" id="battle-defender-units"></div>
            </div>
        </div>

        <div class="odds-bar-container">
            <div id="odds-fill"></div>
            <div class="odds-label">ESTIMATED BALANCE OF FORCE</div>
        </div>

        <div class="battle-choices">
            <button class="pixel-btn" onclick="Game.resolveBattleMode('rt')">1) Fight In Real Time</button>
            <button class="pixel-btn" onclick="Game.resolveBattleMode('ar')">2) Auto-Resolve</button>

3) Fight Turn By Turn

Tactical Engine Mode
Click targets to execute strategy actions
Flee Combat





const Global = {
Factions: {
"Gondor": { name: "Gondor", gold: 500, cities: 1, color: "#b8860b" },
"Mordor": { name: "Mordor", gold: 300, cities: 2, color: "#8b251e" }
},
Units: {
"light_infantry": { name: "Light Infantry", soldiers: 200, damage: 0.35, armor: 0.20, speed: 6 },
"heavy_infantry": { name: "Heavy Infantry", soldiers: 160, damage: 0.50, armor: 0.50, speed: 4 },
"basic_archers":  { name: "Basic Archers",  soldiers: 120, damage: 0.25, armor: 0.15, speed: 5 },
"heavy_cavalry":  { name: "Heavy Cavalry",  soldiers: 80,  damage: 0.70, armor: 0.60, speed: 8 }
},
Cities: [
{ id: 0, name: "Minas Tirith", faction: "Gondor", x: 200, y: 350, baseIncome: 50 },
{ id: 1, name: "Osgiliath", faction: "Mordor", x: 450, y: 300, baseIncome: 50 },
{ id: 2, name: "Minas Morgul", faction: "Mordor", x: 700, y: 250, baseIncome: 50 }
],
Armies: [
{ id: 0, faction: "Gondor", x: 200, y: 350, mp: 10, maxMp: 10, targetX: 200, targetY: 350, units: [
{ type: "heavy_infantry", soldiers: 160 },
{ type: "basic_archers", soldiers: 120 },
{ type: "heavy_cavalry", soldiers: 80 }
]},
{ id: 1, faction: "Mordor", x: 450, y: 300, mp: 10, maxMp: 10, targetX: 450, targetY: 300, units: [
{ type: "light_infantry", soldiers: 200 },
{ type: "light_infantry", soldiers: 200 },
{ type: "basic_archers", soldiers: 120 }
]}
],
Campaign: {
turn: 1,
playerFaction: "Gondor",
phase: "PLAYER"
},
Battle: {
active: false,
attackerArmy: null,
defenderArmy: null,
mode: null
}
};
const Game = {
canvas: null,
ctx: null,
combatCanvas: null,
combatCtx: null,
selectedArmy: null,
isDragging: false,
combatLoopId: null,
combatUnits: [],
init: function() {
this.canvas = document.getElementById("campaignCanvas");
this.ctx = this.canvas.getContext("2d");
this.combatCanvas = document.getElementById("combatCanvas");
this.combatCtx = this.combatCanvas.getContext("2d");
this.resizeCanvases();
window.addEventListener('resize', () => this.resizeCanvases());
this.setupInput();
this.checkSaveState();
this.updateHUD();
this.renderLoop();
},
resizeCanvases: function() {
this.canvas.width = this.canvas.parentElement.clientWidth;
this.canvas.height = this.canvas.parentElement.clientHeight;
this.combatCanvas.width = this.combatCanvas.parentElement.clientWidth;
this.combatCanvas.height = this.combatCanvas.parentElement.clientHeight;
},
checkSaveState: function() {
if(localStorage.getItem("WOTR_Campaign_Save")) {
document.getElementById("btn-continue").style.display = "block";
} else {
document.getElementById("btn-continue").style.display = "none";
}
},
startNewCampaign: function() {
document.getElementById("title-screen").style.display = "none";
this.logMessage("A new Age dawns. Lead Gondor to absolute victory!");
this.saveCampaignState();
},
saveCampaignState: function() {
localStorage.setItem("WOTR_Campaign_Save", JSON.stringify({
Factions: Global.Factions,
Armies: Global.Armies,
Cities: Global.Cities,
Campaign: Global.Campaign
}));
this.checkSaveState();
},
loadCampaign: function() {
let raw = localStorage.getItem("WOTR_Campaign_Save");
if(raw) {
let data = JSON.parse(raw);
Global.Factions = data.Factions;
Global.Armies = data.Armies;
Global.Cities = data.Cities;
Global.Campaign = data.Campaign;
document.getElementById("title-screen").style.display = "none";
this.updateHUD();
this.logMessage("Campaign loaded from localized system archives.");
}
},
logMessage: function(msg) {
let p = document.getElementById("log-panel");
p.innerHTML += <div>• ${msg}</div>;
p.scrollTop = p.scrollHeight;
},
updateHUD: function() {
document.getElementById("hud-faction").innerText = Global.Campaign.playerFaction.toUpperCase();
document.getElementById("hud-faction").style.color = Global.Factions[Global.Campaign.playerFaction].color;
document.getElementById("hud-gold").innerText = Global.Factions[Global.Campaign.playerFaction].gold;
document.getElementById("hud-turn").innerText = Global.Campaign.turn;
let income = 0;
Global.Cities.forEach(c => {
if(c.faction === Global.Campaign.playerFaction) income += c.baseIncome;
});
document.getElementById("hud-income").innerText = income;
},
setupInput: function() {
const getEventPos = (e) => {
let rect = this.canvas.getBoundingClientRect();
let clientX = e.touches ? e.touches.clientX : e.clientX;
let clientY = e.touches ? e.touches.clientY : e.clientY;
return { x: clientX - rect.left, y: clientY - rect.top };
};
const downAction = (pos) => {
if (Global.Campaign.phase !== "PLAYER" || Global.Battle.active) return;
let found = Global.Armies.find(a =>
a.faction === Global.Campaign.playerFaction &&
Math.hypot(a.x - pos.x, a.y - pos.y) < 25
);
if(found) {
this.selectedArmy = found;
this.isDragging = true;
this.triggerScreenShake(5);
}
};
const moveAction = (pos) => {
if (this.isDragging && this.selectedArmy) {
this.selectedArmy.targetX = pos.x;
this.selectedArmy.targetY = pos.y;
}
};
const upAction = () => {
if (this.isDragging && this.selectedArmy) {
this.isDragging = false;
let distance = Math.hypot(this.selectedArmy.targetX - this.selectedArmy.x, this.selectedArmy.targetY - this.selectedArmy.y);
let cost = Math.floor(distance / 40);
if(cost > this.selectedArmy.mp) {
cost = this.selectedArmy.mp;
let angle = Math.atan2(this.selectedArmy.targetY - this.selectedArmy.y, this.selectedArmy.targetX - this.selectedArmy.x);
this.selectedArmy.x += Math.cos(angle) * (cost * 40);
this.selectedArmy.y += Math.sin(angle) * (cost * 40);
} else {
this.selectedArmy.x = this.selectedArmy.targetX;
this.selectedArmy.y = this.selectedArmy.targetY;
}
this.selectedArmy.mp -= cost;
this.selectedArmy.targetX = this.selectedArmy.x;
this.selectedArmy.targetY = this.selectedArmy.y;
this.logMessage(Army moved. Expended ${cost} MP. Remaining: ${this.selectedArmy.mp});
this.checkCollisions();
}
};
this.canvas.addEventListener('mousedown', (e) => downAction(getEventPos(e)));
this.canvas.addEventListener('mousemove', (e) => moveAction(getEventPos(e)));
this.canvas.addEventListener('mouseup', () => upAction());
this.canvas.addEventListener('touchstart', (e) => { e.preventDefault(); downAction(getEventPos(e)); }, { passive: false });
this.canvas.addEventListener('touchmove', (e) => { e.preventDefault(); moveAction(getEventPos(e)); }, { passive: false });
this.canvas.addEventListener('touchend', () => upAction());
this.combatCanvas.addEventListener('click', (e) => {
let rect = this.combatCanvas.getBoundingClientRect();
this.handleCombatClick(e.clientX - rect.left, e.clientY - rect.top);
});
},
triggerScreenShake: function(intensity) {
let el = document.getElementById("game-container");
el.classList.add("shake");
setTimeout(() => el.classList.remove("shake"), 150);
},
checkCollisions: function() {
let pArmy = Global.Armies[0];
let mArmy = Global.Armies[1];
if (pArmy && mArmy && Math.hypot(pArmy.x - mArmy.x, pArmy.y - mArmy.y) < 30) {
this.triggerBattleEngagement(pArmy, mArmy);
}
},
triggerBattleEngagement: function(attacker, defender) {
Global.Battle.active = true;
Global.Battle.attackerArmy = attacker;
Global.Battle.defenderArmy = defender;
document.getElementById("battle-attacker-name").innerText = ${attacker.faction.toUpperCase()} WARLORDS;
document.getElementById("battle-defender-name").innerText = ${defender.faction.toUpperCase()} FORCES;
this.populateUnitCards("battle-attacker-units", attacker.units);
this.populateUnitCards("battle-defender-units", defender.units);
let powerA = this.calculateArmyPower(attacker);
let powerB = this.calculateArmyPower(defender);
let ratio = (powerA / (powerA + powerB)) * 100;
document.getElementById("odds-fill").style.width = ${ratio}%;
document.getElementById("battle-overlay").style.display = "flex";
},
calculateArmyPower: function(army) {
let power = 0;
army.units.forEach(u => {
let spec = Global.Units[u.type];
power += u.soldiers * spec.damage * (1 + spec.armor * 0.5);
});
return power;
},
populateUnitCards: function(elementId, units) {
let container = document.getElementById(elementId);
container.innerHTML = "";
units.forEach(u => {
let spec = Global.Units[u.type];
container.innerHTML += <div class="unit-row-card"> <span><strong>${spec.name}</strong></span> <span style="color: #ff6666;">${u.soldiers} Personnel</span> </div>;
});
},
resolveBattleMode: function(mode) {
document.getElementById("battle-overlay").style.display = "none";
this.triggerScreenShake(12);
if(mode === 'ar') {
this.executeAutoResolve();
} else {
this.enterCombatScene(mode);
}
},
executeAutoResolve: function() {
let att = Global.Battle.attackerArmy;
let def = Global.Battle.defenderArmy;
let pA = this.calculateArmyPower(att);
let pB = this.calculateArmyPower(def);
let jitter = 0.92 + Math.random() * 0.16;
let ratio = (pA / (pA + pB)) * jitter;
let message = "";
if (ratio >= 0.5) {
message = "Gondor secures an operational battlefield victory! ";
let lossFactor = Math.min(0.60, (1 - (pA / (pA + pB))) * 1.40);
att.units.forEach(u => u.soldiers = Math.floor(u.soldiers * (1 - (lossFactor * Math.random()))));
def.units.forEach(u => u.soldiers = 0);
Global.Armies = Global.Armies.filter(a => a.id !== def.id);
} else {
message = "Mordor counter-offensive repels the strike! ";
let lossFactor = Math.min(0.60, (pA / (pA + pB)) * 1.40);
def.units.forEach(u => u.soldiers = Math.floor(u.soldiers * (1 - (lossFactor * Math.random()))));
att.units.forEach(u => u.soldiers = 0);
Global.Armies = Global.Armies.filter(a => a.id !== att.id);
}
alert(CASUALTY ARCHIVE MONITOR:\n\n${message}\nSurviving troops updated accurately.);
this.exitCombatScene(false);
},
enterCombatScene: function(mode) {
Global.Battle.mode = mode;
document.getElementById("combat-scene-container").style.display = "flex";
document.getElementById("combat-mode-title").innerText = mode === 'rt' ? "REAL-TIME SIMULATION" : "TACTICAL GRID SYSTEM";
this.combatUnits = [];
let idCounter = 0;
Global.Battle.attackerArmy.units.forEach((u, index) => {
this.combatUnits.push({
id: idCounter++, team: 'attacker', type: u.type, name: Global.Units[u.type].name,
soldiers: u.soldiers, maxSoldiers: Global.Units[u.type].soldiers,
x: 100, y: 80 + (index * 90), ap: 6, spec: Global.Units[u.type]
});
});
Global.Battle.defenderArmy.units.forEach((u, index) => {
this.combatUnits.push({
id: idCounter++, team: 'defender', type: u.type, name: Global.Units[u.type].name,
soldiers: u.soldiers, maxSoldiers: Global.Units[u.type].soldiers,
x: this.combatCanvas.width - 150, y: 80 + (index * 90), ap: 6, spec: Global.Units[u.type]
});
});
if(mode === 'rt') {
this.combatLoopId = setInterval(() => this.updateRealTimeCombat(), 1000 / 30);
} else {
this.renderTacticalGrid();
}
},
handleCombatClick: function(mx, my) {
if (Global.Battle.mode !== 'tbt') return;
let clicked = this.combatUnits.find(u => Math.hypot(u.x - mx, u.y - my) < 30);
let playerUnit = this.combatUnits.find(u => u.team === 'attacker' && u.soldiers > 0);
if (clicked && clicked.team === 'defender' && playerUnit) {
this.triggerScreenShake(6);
let dmg = Math.floor(playerUnit.soldiers * playerUnit.spec.damage * (1 - clicked.spec.armor * 0.6));
clicked.soldiers = Math.max(0, clicked.soldiers - dmg);
document.getElementById("combat-status-msg").innerText = Struck enemy formation dealing ${dmg} damage!;
let activeDefenders = this.combatUnits.filter(u => u.team === 'defender' && u.soldiers > 0);
if(activeDefenders.length === 0) {
alert("Tactical Victory! Opposing array eliminated.");
this.exitCombatScene(true);
return;
}
setTimeout(() => this.executeAICombatTurn(), 800);
}
this.renderTacticalGrid();
},
executeAICombatTurn: function() {
let aiUnit = this.combatUnits.find(u => u.team === 'defender' && u.soldiers > 0);
let playerUnit = this.combatUnits.find(u => u.team === 'attacker' && u.soldiers > 0);
if (aiUnit && playerUnit) {
let dmg = Math.floor(aiUnit.soldiers * aiUnit.spec.damage * (1 - playerUnit.spec.armor * 0.6));
playerUnit.soldiers = Math.max(0, playerUnit.soldiers - dmg);
document.getElementById("combat-status-msg").innerText = AI counters, killing ${dmg} of your soldiers!;
if (playerUnit.soldiers <= 0) {
alert("Your force was wiped out on the tactical layout.");
this.exitCombatScene(false);
}
}
this.renderTacticalGrid();
},
updateRealTimeCombat: function() {
let ctx = this.combatCtx;
ctx.clearRect(0,0, this.combatCanvas.width, this.combatCanvas.height);
ctx.fillStyle = "#2d241e";
ctx.fillRect(0,0, this.combatCanvas.width, this.combatCanvas.height);
let attackersAlive = false;
let defendersAlive = false;
this.combatUnits.forEach(u => {
if (u.soldiers <= 0) return;
if (u.team === 'attacker') {
attackersAlive = true;
u.x += 1.5;
} else {
defendersAlive = true;
u.x -= 1.5;
}
ctx.fillStyle = u.team === 'attacker' ? "#b8860b" : "#8b251e";
ctx.strokeStyle = "#fff";
ctx.lineWidth = 2;
let width = 40 + (u.soldiers / u.maxSoldiers) * 50;
ctx.fillRect(u.x - width/2, u.y - 20, width, 40);
ctx.strokeRect(u.x - width/2, u.y - 20, width, 40);
ctx.fillStyle = "#fff";
ctx.font = "10px Courier Prime";
ctx.fillText(${u.name}, u.x - width/2, u.y - 25);
ctx.fillText(Men: ${u.soldiers}, u.x - width/2, u.y + 35);
this.combatUnits.forEach(target => {
if (target.team !== u.team && target.soldiers > 0 && Math.abs(u.x - target.x) < 45 && Math.abs(u.y - target.y) < 40) {
u.soldiers = Math.max(0, u.soldiers - 1);
target.soldiers = Math.max(0, target.soldiers - 1);
}
});
});
if(!defendersAlive) {
clearInterval(this.combatLoopId);
alert("Victory! The field belongs to Gondor.");
this.exitCombatScene(true);
} else if(!attackersAlive) {
clearInterval(this.combatLoopId);
alert("Defeat! Mordor streams unchecked across the region.");
this.exitCombatScene(false);
}
},
renderTacticalGrid: function() {
let ctx = this.combatCtx;
ctx.clearRect(0,0, this.combatCanvas.width, this.combatCanvas.height);
ctx.fillStyle = "#1e221a";
ctx.fillRect(0,0, this.combatCanvas.width, this.combatCanvas.height);
ctx.strokeStyle = "#2d3327";
ctx.lineWidth = 1;
for (let i = 0; i < 14; i++) {
for (let j = 0; j < 10; j++) {
ctx.strokeRect(40 + i * 50, 40 + j * 45, 50, 45);
}
}
this.combatUnits.forEach(u => {
if (u.soldiers <= 0) return;
ctx.fillStyle = u.team === 'attacker' ? "#b8860b" : "#8b251e";
ctx.beginPath();
ctx.arc(u.x, u.y, 22, 0, Math.PI * 2);
ctx.fill();
ctx.stroke();
ctx.fillStyle = "#fff";
ctx.font = "9px Courier Prime";
ctx.fillText(u.name, u.x - 18, u.y - 2);
ctx.fillText(P:${u.soldiers}, u.x - 18, u.y + 10);
});
},
exitCombatScene: function(applySurvivors) {
clearInterval(this.combatLoopId);
document.getElementById("combat-scene-container").style.display = "none";
if (applySurvivors && Global.Battle.attackerArmy && Global.Battle.defenderArmy) {
this.combatUnits.forEach(cu => {
let parentArmy = cu.team === 'attacker' ? Global.Battle.attackerArmy : Global.Battle.defenderArmy;
if(parentArmy) {
let matchingUnit = parentArmy.units.find(u => u.type === cu.type);
if(matchingUnit) matchingUnit.soldiers = cu.soldiers;
}
});
Global.Armies.forEach(a => {
a.units = a.units.filter(u => u.soldiers > 0);
});
Global.Armies = Global.Armies.filter(a => a.units.length > 0);
}
Global.Battle.active = false;
this.updateHUD();
this.saveCampaignState();
},
endTurn: function() {
Global.Campaign.phase = "AI";
this.logMessage("Executing AI tactical turns logic streams...");
Object.keys(Global.Factions).forEach(fKey => {
let faction = Global.Factions[fKey];
let income = 0;
Global.Cities.forEach(c => {
if(c.faction === faction.name) income += c.baseIncome;
});
faction.gold += income;
});
Global.Campaign.turn += 1;
Global.Armies.forEach(a => a.mp = a.maxMp);
setTimeout(() => {
Global.Campaign.phase = "PLAYER";
this.updateHUD();
this.saveCampaignState();
this.logMessage(Turn ${Global.Campaign.turn} begun. Control restored.);
}, 1000);
},
renderLoop: function() {
let ctx = this.ctx;
ctx.clearRect(0,0, this.canvas.width, this.canvas.height);
ctx.fillStyle = "#342d24";
ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
ctx.fillStyle = "#1c1813";
ctx.fillRect(380, 0, 45, this.canvas.height);
Global.Cities.forEach(c => {
ctx.fillStyle = Global.Factions[c.faction].color;
ctx.fillRect(c.x - 15, c.y - 15, 30, 30);
ctx.strokeStyle = "#fff";
ctx.strokeRect(c.x - 15, c.y - 15, 30, 30);
ctx.fillStyle = "#fff";
ctx.font = "bold 11px Courier Prime";
ctx.fillText(c.name, c.x - 30, c.y - 22);
});
Global.Armies.forEach(a => {
ctx.fillStyle = Global.Factions[a.faction].color;
ctx.beginPath();
ctx.arc(a.x, a.y, 20, 0, Math.PI * 2);
ctx.fill();
ctx.lineWidth = 3;
ctx.strokeStyle = (this.selectedArmy === a && this.isDragging) ? "#ffff00" : "#ffffff";
ctx.stroke();
let count = a.units.reduce((sum, u) => sum + u.soldiers, 0);
ctx.fillStyle = "#fff";
ctx.font = "10px Courier Prime";
ctx.fillText([${count}], a.x - 14, a.y + 4);
ctx.fillText(MP:${a.mp}, a.x - 14, a.y + 32);
});
requestAnimationFrame(() => this.renderLoop());
}
};
window.onload = () => Game.init();

